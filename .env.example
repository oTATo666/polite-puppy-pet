# 礼貌小狗 · 配置模板（复制成 .env 后按需修改，改完重启桌宠生效）
# ---------------------------------------------------------------------------
# 这个文件是给新机器用的模板：**不含任何密钥、不含任何绝对路径**。
# 用法：复制成 .env，把要用的那几行取消注释填上；不填也能跑（全程本地）。
# ---------------------------------------------------------------------------
# 注意：.env 里有 Key，属于私密文件，永远不要放进外发包、不要提交到仓库。
# ---------------------------------------------------------------------------

# 第 1 层：本地 Ollama（默认，免费、离线可用）
# 模型名必须是 `ollama list` 里真实存在的，写错会自动换成装着的那一个。
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=

# 第 2 层：云端备用（本地连不上 / 没装 Ollama 时自动切过去）
# 填了 Key 才生效，三个都取消注释即可。[!] 启用云端后，聊天内容会离开本机。
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-换成你自己的

# 第 3 层（可选）：任意 OpenAI 兼容接口作为额外备用
# PUPPY_BACKUP_BASE_URL=https://api.siliconflow.cn/v1
# PUPPY_BACKUP_MODEL=Qwen/Qwen2.5-7B-Instruct
# PUPPY_BACKUP_API_KEY=sk-换成你自己的

# 对话音源（克隆音色，不用系统自带 TTS）
# ---------------------------------------------------------------------------
# 相对路径以程序目录（main.py / exe 所在目录）为基准，不用写盘符。
# 指向当前音色档案 voices/profiles/<id>/，和 ref.wav、台词库放在一起。
VOICE_CHAT_FILE=voices/profiles/小狗/chat.wav
VOICE_CHAT_TEXT=

# [!] 禁止使用系统自带音色（默认 0 = 不用系统嗓子）
VOICE_ALLOW_SYSTEM=0
# 即使误开系统嗓子，也不做任何变调
VOICE_SAPI_PITCH=0
VOICE_SAPI_RATE=0

# 兼容老配置：1 只表示「允许用对话音源」，仍然按 VOICE_CHAT_TEXT 精确匹配才播
VOICE_FILE_FALLBACK=1

# 克隆合成：所有自由文本都走克隆（1 = 不限长度，全部用克隆声音）
VOICE_CLONE_ALWAYS=1
# 整段一次合成的字数上限：一句回复整段合成，超长才按标点收口
VOICE_CLONE_SPEAK_CHARS=200
# 仅在 CLONE_ALWAYS=0 时才生效：只对这么短的句子启用克隆（0 = 不限制）
VOICE_CLONE_MAX_CHARS=0

# 语音输入：识别置信度低于这个值的「一两个字」当噪声丢掉（0~1）
VOICE_STT_MIN_CONF=0.08

# 克隆音色实时合成（F5-TTS 本地服务，GPU）
# ---------------------------------------------------------------------------
# 后台常驻一个本地 F5-TTS 服务，把任意文本合成小狗的克隆音色。
# 启动方式：双击 启动克隆音色服务.cmd（它会用 %~dp0 定位自己，换目录也能用）
# 克隆环境用哪个 Python 由 F5_PYTHON 指定；不填则依次尝试：
#   1) 环境变量 F5_PYTHON（绝对路径，或相对程序目录的路径）
#   2) 程序目录下的 .venv\Scripts\python.exe
#   3) 程序目录下的 voice-clone-env\Scripts\python.exe
# 都没有就跳过自动拉起（语音回落到音色档案里的台词库）。
# F5_PYTHON=.venv\Scripts\python.exe
VOICE_TTS_MODE=openai
VOICE_TTS_URL=http://127.0.0.1:9880/v1
VOICE_TTS_KEY=
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=

# 本机大脑：要不要借外部小模型的措辞
# ---------------------------------------------------------------------------
# 1 = 借（默认）：计划永远由本机大脑产出，只把「怎么说」交给小模型起稿，
#     起稿必须过人格闸门，过不了就回落到 brain.json 里它自己说过的原话。
# 0 = 完全不用外部模型，纯离线。
BRAIN_HYBRID=1

# 显存控制（语音是唯一用显卡的部件，必须封顶）
# ---------------------------------------------------------------------------
# 这个服务最多能用掉多少比例的显存（0~1）。留 0 或空 = 不限制。
F5_VRAM_FRACTION=0.25
# 没人说话这么久之后，把模型从显存里卸掉（分钟）。0 = 一直驻留。
F5_IDLE_UNLOAD_MIN=10
# 扩散步数：GPU 上 12 步就够，调到 8 更快、音质略降。
F5_NFE=10
# 半精度（autocast）：1 = 开
F5_FP16=1

# 数据目录（可选）：默认放在 %LOCALAPPDATA%\PolitePuppyPet
# 想跟 OneDrive 脱钩、或想放到移动硬盘，取消注释改成自己的绝对路径
# POLITE_PUPPY_DATA=

# ============================================================
# PolitePuppy server-mode environment template
# Copy to app/.env and fill in real values (deploy.ps1 does this)
# NEVER commit the real .env to git.
# ============================================================

# ---- Server mode switches ----
POLITE_PUPPY_SERVER=1
POLITE_PUPPY_BIND=127.0.0.1
POLITE_PUPPY_PORT=8765
# Comma-separated hostnames the reverse proxy may send.
# MUST include your domain, e.g. dog.example.com
# For direct IP access add: 82.157.130.132:8765
POLITE_PUPPY_ALLOWED_HOSTS=

# ---- Writable data dir (memory db / settings / logs) ----
POLITE_PUPPY_DATA=D:\PolitePuppyData

# ---- LLM backend (OpenAI-compatible endpoint) ----
# 2C2G server CANNOT run Ollama locally. Use a cloud API:
#   DeepSeek:    https://api.deepseek.com/v1      model: deepseek-chat
#   SiliconFlow: https://api.siliconflow.cn/v1    model: Qwen/Qwen2.5-7B-Instruct
#   Zhipu:       https://open.bigmodel.cn/api/paas/v4  model: glm-4-flash
OLLAMA_BASE_URL=https://api.deepseek.com/v1
OLLAMA_MODEL=deepseek-chat
OLLAMA_API_KEY=sk-REPLACE_ME
